diff --git a/gerby/views/reader.py b/gerby/views/reader.py
new file mode 100644
index 0000000000000000000000000000000000000000..79f917cab6879a0d8f3faec1229cda15e8109daa
--- /dev/null
+++ b/gerby/views/reader.py
@@ -0,0 +1,46 @@
+"""Continuous whole-book, part, chapter and section views of Gerby's HTML."""
+import re
+from flask import render_template, abort
+from gerby.application import app
+from gerby.database import Tag, Part, BibliographyEntry
+from gerby.presentation import with_source_sidenotes
+from gerby.views.bibliography import decorateEntries
+
+@app.route('/read')
+@app.route('/read/<string:identifier>')
+def show_reader(identifier=None):
+    tags = list(sorted(Tag.select().where(Tag.active == True)))
+    scope = next((tag for tag in tags if tag.tag == identifier), None) if identifier else None
+    if identifier and (not scope or scope.type not in ['part', 'chapter', 'section', 'subsection']):
+        abort(404)
+    parts = {row.chapter_id: row.part for row in Part.select()}
+    selected = [tag for tag in tags if tag.type in ['chapter', 'section', 'subsection']]
+    if scope:
+        if scope.type == 'part':
+            chapters = {key for key, part in parts.items() if part.tag == scope.tag}
+            refs = [tag.ref + '.' for tag in tags if tag.tag in chapters]
+            selected = [tag for tag in selected if tag.tag in chapters or any(tag.ref.startswith(ref) for ref in refs)]
+        else:
+            selected = [tag for tag in selected if tag.tag == scope.tag or tag.ref.startswith(scope.ref + '.')]
+    included = {tag.tag for tag in selected}
+    for tag in selected:
+        included.update(re.findall(r'id="([0-9A-Z]{4})"', tag.html))
+    chunks = []
+    seen_parts = set()
+    for tag in selected:
+        if tag.type == 'chapter' and tag.tag in parts and (not scope or scope.type == 'part'):
+            part = parts[tag.tag]
+            if part.tag not in seen_parts:
+                chunks.append({'tag': part, 'html': with_source_sidenotes(part.html)})
+                seen_parts.add(part.tag)
+        text = with_source_sidenotes(tag.html)
+        text = re.sub(r'href="/tag/([0-9A-Z]{4})"',
+                      lambda m: 'href="#' + m[1] + '"' if m[1] in included else m[0], text)
+        text = re.sub(r'(<a\b[^>]*class="environment-identifier"[^>]*href=")#([0-9A-Z]{4})"', r'\1/tag/\2"', text)
+        if not scope:
+            text = re.sub(r'href="/bibliography/([^"/]+)"', r'href="#bib-\1"', text)
+        navigation = tag.type == ('section' if scope and scope.type == 'chapter' else 'chapter')
+        chunks.append({'tag': tag, 'html': text, 'navigation': navigation})
+    entries = sorted(decorateEntries(BibliographyEntry.select())) if not scope else []
+    return render_template('reader.html', chunks=chunks, scope=scope, bibliography=not scope,
+                           entries=entries, reader_title=(scope.name if scope else 'Complete text'))
