diff --git a/gerby/presentation.py b/gerby/presentation.py
new file mode 100644
index 0000000000000000000000000000000000000000..5b6ee8f23f2413f9d6706ae1dcdab6c271d0cd09
--- /dev/null
+++ b/gerby/presentation.py
@@ -0,0 +1,105 @@
+"""Reading context and source sidebars for this Gerby instance.
+
+Mathematical HTML is produced by Gerby. This module separates its source
+paragraphs from the displayed statements and carries the rendered introductory
+prose onto the corresponding individual tag pages.
+"""
+import html as html_module
+import json
+import re
+from functools import lru_cache
+from pathlib import Path
+
+from gerby.configuration import ROOT
+LEAN_PARAGRAPH = re.compile(r"<p>\s*<em>Lean:</em>.*?</p>", re.S)
+CONTEXT = re.compile(
+    r'<div class="reading-context" data-for="context-([^"]+)">(.*?)</div>', re.S)
+HEADINGS = {"part", "chapter", "section", "subsection", "subsubsection"}
+
+
+def without_inline_sources(text):
+    return LEAN_PARAGRAPH.sub("", text)
+
+
+def with_source_sidenotes(text):
+    """Attach source notes to the rendered statement they document."""
+    from flask import render_template
+    records = presentation_data()["sources"]
+    def note(match):
+        record = records.get(match[1], {})
+        if not record.get("links"):
+            return match[0]
+        return render_template("source.sidenote.html", group=record) + match[0]
+    return re.sub(r'<article\b[^>]*\bid="([0-9A-Z]{4})"[^>]*>', note,
+                  without_inline_sources(text))
+
+
+def prepare_presentation(build):
+    from gerby.database import Tag
+    labels = dict(line.split(",", 1)[::-1] for line in
+                  (build / "tags").read_text().splitlines() if line)
+    contexts = {}
+    for path in sorted((build / "document").glob("*.tag")):
+        for label, text in CONTEXT.findall(path.read_text()):
+            if label not in labels:
+                raise ValueError("Context has no corresponding tag: " + label)
+            contexts[labels[label]] = contexts.get(labels[label], "") + text.strip() + "\n"
+    manuscript_map = ROOT.parent / "evidence/statement-map.json"
+    notes = {item["tag"]: item.get("correspondence_note", "")
+             for item in json.loads(manuscript_map.read_text())["items"]} if manuscript_map.exists() else {}
+    records = {}
+    for tag in sorted(Tag.select().where(Tag.active == True)):
+        source_html = tag.html
+        if tag.type in HEADINGS:
+            source_html = re.sub(r"<article\b.*?</article>", "", source_html, flags=re.S)
+        links = []
+        for paragraph in LEAN_PARAGRAPH.findall(source_html):
+            for url, name in re.findall(r'<a href="([^"]+)">(.*?)</a>', paragraph, re.S):
+                record = {"url": html_module.unescape(url),
+                          "name": html_module.unescape(re.sub(r"<[^>]*>", "", name))}
+                if record not in links:
+                    links.append(record)
+        records[tag.tag] = {"tag": tag.tag, "ref": tag.ref,
+                            "kind": tag.type, "links": links,
+                            "note": notes.get(tag.tag, "")}
+    data = {"contexts": contexts, "sources": records}
+    (build / "presentation.json").write_text(json.dumps(data, indent=2) + "\n")
+    presentation_data.cache_clear()
+    return {"statement_contexts": len(contexts),
+            "source_groups": sum(bool(r["links"]) for r in records.values())}
+
+
+@lru_cache(maxsize=1)
+def presentation_data():
+    path = ROOT / "build/presentation.json"
+    return json.loads(path.read_text()) if path.exists() else {"contexts": {}, "sources": {}}
+
+
+def present_tag(tag, mathematical_html):
+    data = presentation_data()
+    text = without_inline_sources(mathematical_html)
+    if tag.type not in HEADINGS:
+        context = data["contexts"].get(tag.tag)
+        if context:
+            text = '<div class="reading-context">' + context + "</div>\n" + text
+        selected = [data["sources"].get(tag.tag, {})]
+    else:
+        selected = [record for record in data["sources"].values()
+                    if record["tag"] == tag.tag or record["ref"].startswith(tag.ref + ".")]
+    groups = [record for record in selected if record.get("links")]
+    return with_source_sidenotes(text), groups
+
+
+def reading_neighbours(tag, original):
+    from gerby.database import Tag
+    if tag.type in HEADINGS:
+        candidates = sorted(Tag.select().where(Tag.active == True, Tag.type == tag.type))
+    else:
+        candidates = sorted(t for t in Tag.select().where(Tag.active == True)
+                            if t.type not in HEADINGS)
+    at = next((i for i, candidate in enumerate(candidates) if candidate.tag == tag.tag), None)
+    if at is None:
+        return original
+    return (candidates[at - 1] if at else None,
+            candidates[at + 1] if at + 1 < len(candidates) else None,
+            original[2])
