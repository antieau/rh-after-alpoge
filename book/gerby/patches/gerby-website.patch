+{% if entry.fields.get('note') %}<span class="bibliography-note">{{ entry.fields['note'] | safe }}.</span>{% endif %}
+{% if entry.fields.get('url') %}<a href="{{ entry.fields['url'] }}">Source</a>{% elif entry.fields.get('doi') %}<a href="https://doi.org/{{ entry.fields['doi'] }}">DOI</a>{% endif %}
+</dd></div>{% endfor %}</dl>
