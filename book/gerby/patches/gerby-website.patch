+ .tagged-page #content > .col-lg-4 {order:-1;width:100%;}
+ .tagged-page section#meta.has-sources {display:block;margin:0 0 32px;padding:0 0 16px;border-top:0;border-bottom:1px solid var(--color-rule);}
+ .tagged-page #meta .tag-tools {display:block;}
+ .tag-tools .page-actions {display:flex;flex-wrap:wrap;gap:10px 20px;}
+ .tag-tools .information,.tag-tools .interaction,.tag-tools hr {display:none;}
+}
+
+#header a,.page-actions a,.toc-actions a,.bibliography-list a,.merged-navigation a {background-image:none!important;padding-right:0!important;}
diff --git a/gerby/static/css/reconstruction.css b/gerby/static/css/reconstruction.css
new file mode 100644
index 0000000000000000000000000000000000000000..804445b05ca2e359b60079fd7e32a38e73bf7796
--- /dev/null
+++ b/gerby/static/css/reconstruction.css
@@ -0,0 +1,67 @@
+/* Instance presentation: mathematical prose first, source correspondence aside. */
+.reading-context {
+  margin-bottom: 1.25rem;
+}
+.reading-context p:last-child {
+  margin-bottom: 0;
+}
+.reading-navigation {
+  display: flex;
+  flex-wrap: wrap;
+  justify-content: space-between;
+  gap: .75rem;
+  margin-top: 2rem;
+  padding-top: 1rem;
+  border-top: 1px solid #d9d8d1;
+  font-size: .9rem;
+}
+.reading-next { margin-left: auto; }
+.source-sidebar {
+  width: 100%;
+  margin: .25rem 0 1.5rem;
+  color: #58616a;
+  font-size: .85rem;
+  text-align: left;
+}
+.formal-sources > summary {
+  cursor: pointer;
+  font-weight: 500;
+  margin-bottom: .8rem;
+}
+.source-sidebar ul {
+  list-style: none;
+  padding-left: .8rem;
+  margin: .6rem 0 1rem;
+}
+.source-sidebar li {
+  padding: 0;
+  margin-bottom: .65rem;
+}
+.source-sidebar a, .source-sidebar code {
+  color: #58616a;
+  font-size: .8rem;
+  overflow-wrap: anywhere;
+  word-break: break-word;
+}
+.source-sidebar a:hover, .source-sidebar a:focus { color: #1d507d; }
+.source-sidebar a[href^="https://github.com"]:after { content: none; }
+.source-sidebar a[href^="https://github.com"] {
+  background-image: none;
+  padding-right: 0;
+}
+.source-group { margin-bottom: .55rem; }
+.source-group > summary a { font-family: inherit; font-size: .85rem; }
+@media (min-width: 992px) {
+  .source-sidebar { max-height: 60vh; overflow-y: auto; }
+}
+@media (max-width: 991px) {
+  section#meta.has-sources {
+    display: block;
+    position: static;
+    margin-top: 2rem;
+    padding: 1rem 0 0;
+    border-top: 1px solid #d9d8d1;
+  }
+  #meta.has-sources .tag-tools { display: none; }
+  .source-sidebar { margin-bottom: 0; }
+}
diff --git a/gerby/static/js/lesswrong-progress.js b/gerby/static/js/lesswrong-progress.js
new file mode 100644
index 0000000000000000000000000000000000000000..ef4c71d83fbfd806913d4de2a14198101c44922d
--- /dev/null
+++ b/gerby/static/js/lesswrong-progress.js
@@ -0,0 +1,276 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Adapted from ForumMagnum / LessWrong (contributors).
+ * Upstream: https://github.com/ForumMagnum/ForumMagnum/tree/a1665ead02e2c00647c098797979c4c994980673
+ * Source: useTocProgressLine.ts and FixedPositionToC.tsx.
+ * Modified 2026-11-12: remove TypeScript types and React lifecycle;
+ * attach to Gerby HTML. Geometry, monotonic keypoints, interpolation,
+ * minimum viewport segment, and proportional row scaling are retained.
+ * Original source and full license: /static/third-party/forum-magnum/.
+ */
+(() => {
+'use strict';
+const TOC_ANCHOR_DATA_ATTRIBUTE = "data-toc-anchor";
+const MIN_LINE_HEIGHT = 10;
+function getContentElement() {
+  return document.getElementById('postContent') ?? document.getElementById('tagContent');
+}
+
+function isHiddenRect(rect) {
+  return rect.width === 0 && rect.height === 0;
+}
+
+function compareByContentY(a, b) {
+  return a.contentY - b.contentY;
+}
+
+/**
+ * Sort keypoints by their position in the post, and drop any that would make
+ * the mapping non-monotonic (eg a heading whose ToC row is above the row of an
+ * earlier heading). The result is strictly increasing in both coordinates.
+ */
+function toMonotonicKeypoints(keypoints) {
+  const sorted = [...keypoints].sort(compareByContentY);
+  const result = [];
+  for (const keypoint of sorted) {
+    const previous = result[result.length - 1];
+    if (!previous || (keypoint.contentY > previous.contentY && keypoint.tocY > previous.tocY)) {
+      result.push(keypoint);
+    }
+  }
+  return result;
+}
+
+/**
+ * Collect the correspondences between positions in the post and positions in
+ * the ToC: the top of the scrollable document lines up with the top of the
+ * progress bar, each heading lines up with the dot of its ToC row, and the
+ * bottom of the post content lines up with the bottom of the progress bar.
+ */
+function getProgressKeypoints({barRect, rows, contentRect, documentTop}) {
+  const keypoints = [
+    { contentY: documentTop, tocY: 0 },
+    { contentY: contentRect.bottom, tocY: barRect.height },
+  ];
+
+  const dots = Array.from(rows.querySelectorAll(`[${TOC_ANCHOR_DATA_ATTRIBUTE}]`));
+  for (const dot of dots) {
+    const anchorId = dot.getAttribute(TOC_ANCHOR_DATA_ATTRIBUTE);
+    const anchor = anchorId ? document.getElementById(anchorId) : null;
+    if (!anchor) continue;
+
+    // Skip headings which aren't currently laid out, eg because they're inside a collapsed section
+    const anchorRect = anchor.getBoundingClientRect();
+    if (isHiddenRect(anchorRect)) continue;
+
+    const dotRect = dot.getBoundingClientRect();
+    keypoints.push({
+      contentY: anchorRect.top,
+      tocY: dotRect.top + (dotRect.height / 2) - barRect.top,
+    });
+  }
+
+  return toMonotonicKeypoints(keypoints);
+}
+
+/**
+ * Map a y-coordinate in the post to a y-coordinate in the ToC by linear
+ * interpolation between the surrounding keypoints. Positions outside the range
+ * of the keypoints are clamped to the nearest end.
+ */
+function interpolateTocY(keypoints, contentY) {
+  if (contentY <= keypoints[0].contentY) {
+    return keypoints[0].tocY;
+  }
+  for (let i = 1; i < keypoints.length; i++) {
+    const upper = keypoints[i];
+    if (contentY <= upper.contentY) {
+      const lower = keypoints[i - 1];
+      const fraction = (contentY - lower.contentY) / (upper.contentY - lower.contentY);
+      return lower.tocY + (fraction * (upper.tocY - lower.tocY));
+    }
+  }
+  return keypoints[keypoints.length - 1].tocY;
+}
+
+function updateProgressLine(progressBar, rows, scrollContainer) {
+  const contentElement = getContentElement();
+  if (!contentElement) return;
+
+  const barRect = progressBar.getBoundingClientRect();
+  const contentRect = contentElement.getBoundingClientRect();
+
+  // The visible region, and the top of the scrollable document, in viewport coordinates
+  const containerRect = scrollContainer?.getBoundingClientRect();
+  const viewportTop = containerRect?.top ?? 0;
+  const viewportBottom = containerRect?.bottom ?? window.innerHeight;
+  const documentTop = (scrollContainer && containerRect)
+    ? containerRect.top - scrollContainer.scrollTop
+    : -window.scrollY;
+
+  const keypoints = getProgressKeypoints({ barRect, rows, contentRect, documentTop });
+  if (keypoints.length < 2) return;
+
+  const lineTop = interpolateTocY(keypoints, viewportTop);
+  const lineBottom = interpolateTocY(keypoints, viewportBottom);
+
+  // Enforce a minimum height, keeping the line inside the bar
+  const lineHeight = Math.max(MIN_LINE_HEIGHT, lineBottom - lineTop);
+  const clampedLineTop = Math.max(0, Math.min(lineTop, barRect.height - lineHeight));
+
+  progressBar.style.setProperty("--windowTop", `${clampedLineTop}px`);
+  progressBar.style.setProperty("--windowHeight", `${lineHeight}px`);
+}
+
+function normalizeToCScale({containerPosition, sections}) {
+  // If we have no sections, just return empty array
+  if (sections.length === 0) return [];
+  
+  // Get the total height of the post content
+  const containerTop = containerPosition?.top || 0;
+  const containerBottom = containerPosition?.bottom || 0;
+  const totalContentHeight = containerBottom - containerTop;
+  
+  // Calculate the gap between container top and first section for proper spacing
+  const firstSectionOffset = sections[0].offset || 0;
+  const gapToFirstSection = firstSectionOffset - containerTop;
+  
+  // Create a virtual spacer for the gap at the top if needed because first heading is not at the top of the page
+  const titleGapSpacer = {
+    title: "",
+    anchor: "spacer",
+    level: 0,
+    offset: containerTop,
+    scale: gapToFirstSection > 0 ? gapToFirstSection / totalContentHeight * 100 : 0,
+    spacer: true
+  };
+  
+  // For each section (corresponding to a heading), calculate a "scale" that's proportional to its position in the document
+  // We will set the flex-grow amount of the corresponding ToC element proportional this value.
+  // The scale for an element is calculated by subtracting its own offset from the offset of the next positioned element.
+  // However, not every element necessarily has an offset; if an element doesn't have one its vertical scale is 0 (ie it 
+  // does not grow past its minimum size), and it's skipped for purposes of deciding what counts as the "next positioned 
+  // element". (When we hit the end of the list, we use containerPosition.bottom in place of the next offset)
+  const normalizedSections = sections.map((section, idx) => {
+    
+    // Find the next section with an offset, or use the container bottom
+    let nextPositionedIdx = idx+1;
+    while (nextPositionedIdx<sections.length && !sections[nextPositionedIdx].offset) {
+      nextPositionedIdx++;
+    }
+    
+    const nextSectionOffset = (nextPositionedIdx>=sections.length)
+      ? containerPosition?.bottom ?? 0
+      : sections[nextPositionedIdx].offset ?? 0;
+    
+    const sectionHeight = nextSectionOffset - (section.offset ?? 0);
+    
+    // Scale is the percentage of total content height this section occupies
+    const sectionScale = section.divider ? 1 : (sectionHeight / totalContentHeight) * 100;
+    
+    return {
+      ...section,
+      offset: section.offset ?? 0,
+      scale: sectionScale
+    };
+  });
+  
+  // Return with spacer if there's a significant gap before the first heading
+  return gapToFirstSection > 50 ? [titleGapSpacer, ...normalizedSections] : normalizedSections;
+};
+
+
+// Gerby adapter. Rendering and mathematical content remain server-side.
+function mountGerbyProgress() {
+  const content = getContentElement();
+  if (!content || content.getBoundingClientRect().height < window.innerHeight * 1.2) return;
+  const rail = document.createElement('nav');
+  rail.className = 'reader-rail';
+  rail.setAttribute('aria-label', 'Reading position and contents');
+  rail.innerHTML = '<button class="reader-rail-toggle" aria-expanded="false" aria-label="Show reading contents">☰</button><div class="reader-rail-inner"><div class="reader-progress" aria-hidden="true"><div class="reader-window"></div></div><div class="reader-rows"></div></div>';
+  document.body.appendChild(rail);
+  const bar = rail.querySelector('.reader-progress');
+  const rows = rail.querySelector('.reader-rows');
+  const button = rail.querySelector('button');
+  const headings = [...content.querySelectorAll('[data-reader-heading]')];
+  if (!headings.length) headings.push(...content.querySelectorAll('h1, h2'));
+  let sections = headings.map((heading, i) => {
+    if (!heading.id) heading.id = 'reading-heading-' + i;
+    const label = heading.querySelector('h1, h2') || heading;
+    return {anchor: heading.id, title: label.textContent.trim()};
+  });
+  if (!sections.length) {
+    if (!content.id) content.id = 'tagContent';
+    sections = [{anchor:content.id, title:document.title.split('—')[0]}];
+  }
+  for (const section of sections) {
+    const row = document.createElement('div');
+    row.className = 'reader-row';
+    const dot = document.createElement('a');
+    dot.href = '#' + section.anchor;
+    dot.className = 'reader-dot';
+    dot.setAttribute(TOC_ANCHOR_DATA_ATTRIBUTE, section.anchor);
+    dot.setAttribute('aria-label', section.title);
+    const label = document.createElement('a');
+    label.href = dot.href;
+    label.className = 'reader-label';
+    label.textContent = section.title;
+    row.append(dot, label); rows.appendChild(row);
+  }
+  button.addEventListener('click', () => {
+    const open = rail.classList.toggle('is-open');
+    button.setAttribute('aria-expanded', String(open));
+    if (!open && window.matchMedia('(max-width: 991px)').matches) button.blur();
+  });
+  rail.addEventListener('keydown', event => {
+    if (event.key === 'Escape') { rail.classList.remove('is-open');button.setAttribute('aria-expanded','false');button.focus(); }
+  });
+  rail.addEventListener('click', event => {
+    const link = event.target.closest('a');
+    if (link) {
+      rail.classList.remove('is-open');button.setAttribute('aria-expanded','false');
+      if (window.matchMedia('(max-width: 991px)').matches) {
+        const anchor = document.getElementById(link.hash.slice(1));
+        if (anchor) {anchor.tabIndex = -1;anchor.focus({preventScroll:true});}
+      }
+    }
+  });
+  const measureRows = () => {
+    const bounds = content.getBoundingClientRect();
+    const measured = sections.map(section => ({...section, offset:document.getElementById(section.anchor).getBoundingClientRect().top + window.scrollY}));
+    const normalized = normalizeToCScale({sections:measured,containerPosition:{top:bounds.top + window.scrollY,bottom:bounds.bottom + window.scrollY}});
+    for (const section of normalized) {
+      if (section.spacer) continue;
+      const row = rows.querySelector('[data-toc-anchor="' + section.anchor + '"]').parentNode;
+      row.style.flexGrow = String(Math.max(0, section.scale || 0));
+    }
+  };
+  let pendingFrame = null;
+  let needsMeasurement = true;
+  const update = () => {
+    pendingFrame = null;
+    if (needsMeasurement) {measureRows();needsMeasurement = false;}
+    updateProgressLine(bar, rows, null);
+    const currentY = window.innerHeight * 0.22;
+    let active = sections[0]?.anchor;
+    for (const section of sections) {
+      if (document.getElementById(section.anchor).getBoundingClientRect().top <= currentY) active = section.anchor;
+    }
+    for (const dot of rows.querySelectorAll('[data-toc-anchor]')) {
+      const current = dot.getAttribute(TOC_ANCHOR_DATA_ATTRIBUTE) === active;
+      dot.parentNode.classList.toggle('is-current', current);
+      if (current) dot.setAttribute('aria-current','location'); else dot.removeAttribute('aria-current');
+    }
+  };
+  const scheduleUpdate = () => {if (pendingFrame === null) pendingFrame = window.requestAnimationFrame(update);};
+  const remeasure = () => {needsMeasurement = true;scheduleUpdate();};
+  window.addEventListener('scroll', scheduleUpdate, {passive:true});
+  window.addEventListener('resize', remeasure);
+  const observer = new ResizeObserver(remeasure);
+  observer.observe(content);observer.observe(rows);
+  if (document.fonts?.ready) document.fonts.ready.then(remeasure);
+  window.addEventListener('load', remeasure, {once:true});
+  update();
+}
+if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded',mountGerbyProgress);
+else mountGerbyProgress();
+})();
diff --git a/gerby/static/js/source-sidenotes.js b/gerby/static/js/source-sidenotes.js
new file mode 100644
index 0000000000000000000000000000000000000000..0e4e09a0a9b3034da2c736031a207f5771834b60
--- /dev/null
+++ b/gerby/static/js/source-sidenotes.js
@@ -0,0 +1,37 @@
+/* Statement-aligned source notes. Gerby's rendered mathematics remains in place. */
+(() => {
+  const notes = [...document.querySelectorAll('.lean-sidenote')];
+  if (!notes.length) return;
+  const content = document.getElementById('postContent') || document.getElementById('tagContent');
+  content.classList.add('sidenote-content');
+  const wide = window.matchMedia('(min-width: 1200px)');
+  let frame = 0;
+  function arrange() {
+    frame = 0;
+    if (!wide.matches) { notes.forEach(n => n.style.removeProperty('top')); return; }
+    const origin = content.getBoundingClientRect().top + window.scrollY;
+    const tools = document.querySelector('.tag-tools');
+    let floor = tools ? tools.getBoundingClientRect().bottom + window.scrollY - origin + 28 : 0;
+    notes.forEach(note => {
+      const statement = document.getElementById(note.dataset.sourceFor);
+      if (!statement) return;
+      const top = Math.max(floor, statement.getBoundingClientRect().top + window.scrollY - origin);
+      note.style.top = top + 'px';
+      floor = top + note.getBoundingClientRect().height + 26;
+    });
+    content.style.minHeight = Math.max(0, floor) + 'px';
+  }
+  function schedule() { if (!frame) frame = requestAnimationFrame(arrange); }
+  function mode() {
+    notes.forEach(note => { note.querySelector('details').open = wide.matches; });
+    content.style.removeProperty('min-height');
+    schedule();
+  }
+  mode(); wide.addEventListener('change', mode);
+  notes.forEach(n => n.addEventListener('toggle', schedule, true));
+  window.addEventListener('resize', schedule, {passive:true});
+  window.addEventListener('load', schedule);
+  if (document.fonts) document.fonts.ready.then(schedule);
+  if (window.ResizeObserver) { const ro = new ResizeObserver(schedule); ro.observe(content); }
+  if (window.MathJax && MathJax.Hub) MathJax.Hub.Queue(schedule);
+})();
